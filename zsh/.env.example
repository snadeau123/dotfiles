# Dotfiles Environment Variables
# Copy this file to ~/.dotfiles.env and fill in your values
# This file should NOT be committed to git

# OpenRouter API Key (for claude-* aliases)
OPENROUTER_API_KEY="your-api-key-here"

# Cerebras API Key (for claude-*-cb aliases via claude-code-router)
CEREBRAS_API_KEY="your-cerebras-api-key-here"

# Groq API Key (for cli-ai natural language shell commands)
GROQ_API_KEY="your-groq-api-key-here"
